#!/bin/zsh
# talk-keys — build / install / control the Right Option speak daemon.
# Usage: talk-keys {build|install|uninstall|start|stop|status|restart|doctor}

set -euo pipefail

ROOT="${TALK_KEYS_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
SRC="$ROOT/Sources/talk-keys.swift"
APP="${TALK_KEYS_APP:-$HOME/Applications/Talk Keys.app}"
BIN="$APP/Contents/MacOS/talk-keys"
LABEL="com.stevederico.talk-keys"
PLIST_SRC="$ROOT/launchd/${LABEL}.plist"
PLIST_DEST="$HOME/Library/LaunchAgents/${LABEL}.plist"
LOG="/tmp/talk-keys.log"
LEGACY_BIN="$HOME/.cache/talk-keys"

build() {
  mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
  cp "$ROOT/Resources/Info.plist" "$APP/Contents/Info.plist"
  if [ -f "$ROOT/Resources/AppIcon.icns" ]; then
    cp "$ROOT/Resources/AppIcon.icns" "$APP/Contents/Resources/AppIcon.icns"
  fi
  # Recompiling / re-signing changes CDHash and drops TCC grants.
  # Only rebuild when sources are newer than the binary.
  if [[ ! -x "$BIN" || "$SRC" -nt "$BIN" ]]; then
    xcrun swiftc -O -o "$BIN" "$SRC"
    # Bind Info.plist + stable bundle id so launchd inherits Accessibility grants.
    codesign -s - --force --deep --identifier "$LABEL" "$APP" 2>/dev/null || true
    echo "built $APP (re-enable Accessibility + Input Monitoring after rebuild)"
  else
    echo "ok    $APP (up to date)"
  fi
  mkdir -p "$HOME/.cache"
  ln -sfn "$BIN" "$LEGACY_BIN"
}

write_plist() {
  # Launch via `open -W -n -a` so TCC attaches to Talk Keys.app (not the Mach-O).
  # Do not pass -g (background): AX/ListenEvent prompts never appear and grants stay false.
  mkdir -p "$HOME/Library/LaunchAgents"
  # Never write through a symlink into the repo sample (that baked $HOME into git).
  if [ -L "$PLIST_DEST" ]; then
    rm -f "$PLIST_DEST"
  fi
  cat > "$PLIST_DEST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>${LABEL}</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>${LABEL}</string>
	</array>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/open</string>
		<string>-W</string>
		<string>-n</string>
		<string>-a</string>
		<string>${APP}</string>
		<string>-o</string>
		<string>${LOG}</string>
		<string>--stderr</string>
		<string>${LOG}</string>
	</array>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>${LOG}</string>
	<key>StandardErrorPath</key>
	<string>${LOG}</string>
</dict>
</plist>
EOF
}

load_agent() {
  write_plist
  launchctl bootout "gui/$(id -u)/${LABEL}" 2>/dev/null || true
  pkill -x talk-keys 2>/dev/null || true
  launchctl bootout "gui/$(id -u)/com.stevederico.speak-hotkey" 2>/dev/null || true
  rm -f "$HOME/Library/LaunchAgents/com.stevederico.speak-hotkey.plist"
  if [[ -f "$LEGACY_BIN" && ! -L "$LEGACY_BIN" ]]; then
    rm -f "$LEGACY_BIN"
    ln -sfn "$BIN" "$LEGACY_BIN"
  fi
  : > "$LOG"
  if launchctl bootstrap "gui/$(id -u)" "$PLIST_DEST" 2>/dev/null; then
    echo "loaded $LABEL"
  elif launchctl kickstart -k "gui/$(id -u)/${LABEL}" 2>/dev/null; then
    echo "restarted $LABEL"
  else
    echo "warn: could not load $LABEL — approve in System Settings → Login Items" >&2
    return 1
  fi
  sleep 0.5
}

install_agent() {
  build
  load_agent
  if grep -q 'AX=false\|ListenEvent=false' "$LOG" 2>/dev/null; then
    echo ""
    echo "Enable Talk Keys in BOTH (toggle off then on if already listed):"
    echo "  System Settings → Privacy & Security → Accessibility"
    echo "  System Settings → Privacy & Security → Input Monitoring"
    echo "Then: talk-keys restart   # does not rebuild"
    open "x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility" 2>/dev/null || true
  fi
}

uninstall_agent() {
  launchctl bootout "gui/$(id -u)/${LABEL}" 2>/dev/null || true
  rm -f "$PLIST_DEST"
  rm -rf "$APP"
  rm -f "$LEGACY_BIN"
  echo "uninstalled $LABEL"
}

status() {
  if launchctl print "gui/$(id -u)/${LABEL}" >/dev/null 2>&1; then
    echo "loaded"
    pgrep -lf 'Talk Keys|talk-keys' || true
    tail -8 "$LOG" 2>/dev/null || true
  else
    echo "not loaded"
    return 1
  fi
}

doctor() {
  status || true
  echo "---"
  echo "App: $APP"
  ls -la "$BIN" 2>/dev/null || echo "missing binary"
  echo "Tap Right Option once, then: tail -f $LOG"
  echo "Expect: right-option alone → speak; right-command hold → dictate start|stop"
}

cmd="${1:-status}"
case "$cmd" in
  build) build ;;
  install) install_agent ;;
  uninstall) uninstall_agent ;;
  start|restart)
    # Never rebuild on restart — recompile drops TCC grants.
    load_agent
    tail -5 "$LOG" 2>/dev/null || true
    ;;
  stop)
    launchctl bootout "gui/$(id -u)/${LABEL}" 2>/dev/null || true
    echo "stopped $LABEL"
    ;;
  status) status ;;
  doctor) doctor ;;
  *)
    echo "usage: talk-keys {build|install|uninstall|start|stop|status|restart|doctor}" >&2
    exit 2
    ;;
esac
